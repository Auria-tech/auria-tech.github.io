# Copy to .env and fill in. .env is gitignored and must stay that way.
# These credentials read our analytics; they are not needed to build the site.
# See docs/analytics.md.

# The Umami instance. Use the admin hostname, not the tracker hostname.
UMAMI_HOST=https://analytics.auria-tech.com

UMAMI_USERNAME=admin
UMAMI_PASSWORD=

# Public identifier for the Auria site. Not a secret — it is in the page source.
UMAMI_WEBSITE_ID=393a4821-c400-4a65-ab8a-a42a7284b705
