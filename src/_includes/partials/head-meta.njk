{#
  Everything a search engine, a social network or a feed reader reads about the
  page. Kept in one partial so there is a single place to answer "what do we
  tell crawlers?" — layouts/base.njk just includes it.

  Front matter a page can set:
    title       page title (falls back to the site title)
    description one sentence (falls back to the site description)
    ogType      "article" on posts, "website" everywhere else
    image       page-specific share image, e.g. /images/my-post.png
    noindex     true to keep the page out of search results and the sitemap
    updated     a post that was materially revised after publishing
#}
{%- set pageUrl = page.url | htmlBaseUrl(site.url) -%}
{%- set pageTitle = title or site.title -%}
{%- set pageDescription = description or site.description -%}
{%- set shareImage = (image or site.image) | htmlBaseUrl(site.url) -%}
{%- set modified = updated or date -%}

<title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
<meta name="description" content="{{ pageDescription }}" />
<link rel="canonical" href="{{ pageUrl }}" />
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml" />
{%- if noindex %}
{# Thin or transactional pages. "follow" so the links on them still carry. #}
<meta name="robots" content="noindex, follow" />
{%- endif %}

<meta property="og:type" content="{{ ogType or 'website' }}" />
<meta property="og:title" content="{{ pageTitle }}" />
<meta property="og:description" content="{{ pageDescription }}" />
<meta property="og:url" content="{{ pageUrl }}" />
<meta property="og:site_name" content="{{ site.title }}" />
<meta property="og:locale" content="{{ site.locale }}" />
<meta property="og:image" content="{{ shareImage }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="{{ imageAlt or site.imageAlt }}" />
{%- if ogType == 'article' %}
<meta property="article:published_time" content="{{ date | dateToRfc3339 }}" />
<meta property="article:modified_time" content="{{ modified | dateToRfc3339 }}" />
{%- for tag in tags %}
<meta property="article:tag" content="{{ tag }}" />
{%- endfor %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ pageTitle }}" />
<meta name="twitter:description" content="{{ pageDescription }}" />
<meta name="twitter:image" content="{{ shareImage }}" />

{#
  Structured data. Posts describe themselves as a BlogPosting; the home page
  describes the site. Built as a Nunjucks object and serialised by the `jsonld`
  filter, so a quote or an apostrophe in a title cannot produce invalid JSON —
  hand-written JSON in a template breaks the moment someone writes a post
  called "Don't".
#}
{%- set publisher = {
  "@type": "Organization",
  "name": site.author,
  "url": site.url + "/",
  "logo": { "@type": "ImageObject", "url": shareImage }
} -%}
{%- if ogType == 'article' -%}
{%- set schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "url": pageUrl,
  "headline": title,
  "description": pageDescription,
  "image": [shareImage],
  "datePublished": date | dateToRfc3339,
  "dateModified": modified | dateToRfc3339,
  "author": { "@type": "Organization", "name": site.author, "url": site.url + "/" },
  "publisher": publisher,
  "inLanguage": site.language,
  "keywords": (tags or []) | join(", "),
  "isAccessibleForFree": true
} -%}
{%- elif page.url == '/' -%}
{%- set schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": site.url + "/#website",
  "url": site.url + "/",
  "name": site.title,
  "description": site.description,
  "inLanguage": site.language,
  "publisher": publisher
} -%}
{%- else -%}
{%- set schema = none -%}
{%- endif -%}
{%- if schema %}
<script type="application/ld+json">{{ schema | jsonld | safe }}</script>
{%- endif %}
