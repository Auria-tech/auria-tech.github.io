{#
  Renders a list of posts. Callers set two variables before including it:

    listPosts   the posts to render (required)
    listLevel   heading level for post titles, 2 or 3 (default 3)

  Kept in one place so the home page, archive and tag pages cannot drift apart.
#}
{% set level = listLevel or 3 %}
<ul class="post-list">
  {%- for post in listPosts %}
    <li>
      <h{{ level }}>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        {%- if post.data.draft %} <span class="badge">Draft</span>{% endif %}
      </h{{ level }}>
      <p class="meta">
        <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
        {%- if post.data.tags | length %}
          <span class="tag-list">
            {%- for tag in post.data.tags %}
              <a href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
            {%- endfor %}
          </span>
        {%- endif %}
      </p>
      {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
    </li>
  {%- endfor %}
</ul>
