<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="canonical" href="{{ page.url | htmlBaseUrl(site.url) }}" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml" />

    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ page.url | htmlBaseUrl(site.url) }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta name="twitter:card" content="summary" />

    {# Inlined so the first paint costs no extra request. See _includes/css/main.css. #}
    <style>{% include "css/main.css" %}</style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <p class="site-title"><a href="/">{{ site.title }}</a></p>
      <nav aria-label="Main">
        <ul>
          <li><a href="/">Writing</a></li>
          <li><a href="/feed.xml">RSS</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>{{ site.title }} — <a href="/feed.xml">subscribe by RSS</a></p>
    </footer>
  </body>
</html>
