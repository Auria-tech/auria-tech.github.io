<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {# Title, description, canonical, social cards and structured data. #}
    {% include "partials/head-meta.njk" %}

    {# Inlined so the first paint costs no extra request. See _includes/css/main.css. #}
    <style>{% include "css/main.css" %}</style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <p class="site-title"><a href="/">{{ site.title }}</a></p>
      <nav aria-label="Main">
        <ul>
          <li><a href="/">Writing</a></li>
          <li><a href="/archive/">Archive</a></li>
          <li><a href="/subscribe/">Subscribe</a></li>
          <li><a href="/feed.xml">RSS</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>
        {{ site.title }} — <a href="/subscribe/">subscribe by email</a> or
        <a href="/feed.xml">by RSS</a>. <a href="/privacy/">Privacy</a>.
      </p>
    </footer>

    {% include "partials/analytics.njk" %}
  </body>
</html>
