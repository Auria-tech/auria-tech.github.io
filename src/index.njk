---
layout: layouts/base.njk
# This page is a list of posts, so it is "modified" whenever a post is added.
sitemapLastmod: newestPost
---

<h1>{{ site.title }}</h1>
<p>{{ site.description }}</p>

<h2>Latest writing</h2>

{% if collections.posts | length %}
  {% set listPosts = collections.posts | limit(10) %}
  {% include "partials/post-list.njk" %}

  {% if collections.posts | length > 10 %}
    <p><a href="/archive/">All {{ collections.posts | length }} posts →</a></p>
  {% endif %}
{% else %}
  <p>Nothing published yet.</p>
{% endif %}

{% include "partials/subscribe.njk" %}
