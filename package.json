{
  "name": "auria-site",
  "version": "0.1.0",
  "private": true,
  "description": "Auria's owned publishing surface. Markdown in, static HTML out.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "check": "npm run check:posts && npm run build && npm run check:seo",
    "check:posts": "node scripts/check-posts.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "report": "node scripts/analytics-report.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "gray-matter": "^4.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
